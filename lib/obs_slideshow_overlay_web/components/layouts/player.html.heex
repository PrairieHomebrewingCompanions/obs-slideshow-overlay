<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title]}</title>
    <%!-- No app.css: its theme would paint a background behind the slides. --%>
    <%!-- The fonts on the computer running the app, so OBS elsewhere has them. --%>
    <link rel="stylesheet" href={~p"/fonts.css"} />
    <style>
      html, body { margin: 0; background: transparent; overflow: hidden; }
    </style>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body data-player-page>
    {@inner_content}
  </body>
</html>
